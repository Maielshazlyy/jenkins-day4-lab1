pipeline {
    agent any

    environment {
        REPO_URL = 'https://github.com/Maielshazlyy/jenkins-day4-lab1.git'
        IMAGE_NAME = 'hello-node'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', credentialsId: 'github-token', url: "${REPO_URL}"
            }
        }
        stage('Build') {
            steps {
                sh 'docker build -t "$IMAGE_NAME:$BUILD_NUMBER" ./node-app'
            }
        }
        stage('Run') {
            steps {
                sh 'docker run --rm --mount "type=bind,source=$WORKSPACE/node-app,target=/app,readonly" "$IMAGE_NAME:$BUILD_NUMBER"'
            }
        }
        stage('Push to Docker Hub') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'dockerhub', usernameVariable: 'DH_USER', passwordVariable: 'DH_TOKEN')]) {
                    sh '''
                        echo "$DH_TOKEN" | docker login --username "$DH_USER" --password-stdin
                        docker tag "$IMAGE_NAME:$BUILD_NUMBER" "$DH_USER/$IMAGE_NAME:$BUILD_NUMBER"
                        docker push "$DH_USER/$IMAGE_NAME:$BUILD_NUMBER"
                        docker logout
                    '''
                }
            }
        }
    }
}
